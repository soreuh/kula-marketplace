# Copy this file to .env.local and fill in real values.
# NOTHING in the code is account-specific — swapping every value below is the
# entire "move to a new owner" procedure (see HANDOVER.md).

# ── Supabase → Project Settings → API ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon" / "publishable" key — safe to expose (RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / "secret" key — bypasses RLS. Server only. Never share, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe → Developers → API keys ────────────────────────────────────────────
# Use sk_test_... until launch, then swap to sk_live_...
STRIPE_SECRET_KEY=sk_test_
# Local dev: printed by `stripe listen`. Production: from the webhook endpoint
# you create in the Stripe dashboard (Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_

# ── App ───────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000 — Production: your Netlify/custom domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact address (footer, terms, privacy). Optional — defaults to the
# one in lib/site.ts; set here to override without a code change.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Optional features (leave blank to keep them switched off) ─────────────────
# AI listing-metadata suggestions in the upload dialog (console.anthropic.com).
# Deliberately prefixed KULA_ — hosts like Netlify auto-inject a generic
# ANTHROPIC_API_KEY into every site (their AI Gateway), which would silently
# turn this feature on. The prefix keeps it off until YOU choose otherwise.
KULA_ANTHROPIC_API_KEY=
# Sale-notification emails to sellers (resend.com — free tier is fine)
RESEND_API_KEY=
# Daily review sweep (buyer "how was it?" nudges + seller new-review notices).
# Any long random string (e.g. `openssl rand -hex 32`). The Netlify scheduled
# function sends it as a Bearer token to /api/cron/review-sweep; without it
# the sweep stays switched off entirely. Set it in Netlify env for production.
CRON_SECRET=
# The From address for emails once you verify a domain in Resend
EMAIL_FROM=
# Mailchimp: mirror waitlist/consent signups into an Audience so campaigns
# can be sent from Mailchimp. API key: Account & billing → Extras → API keys.
# Audience ID: Audience → Settings → Audience name and defaults.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Google Analytics 4: the G-XXXXXXXXXX Measurement ID from your web data
# stream (GA → Admin → Data streams). Public by nature — safe in the browser.
# NOTE: before setting this in production, update /privacy §7 (it currently
# promises "no tracking cookies", and GA sets them).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
