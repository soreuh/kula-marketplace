# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — SECRETS, never commit. The template is the one exception:
# it holds no values and the setup/handover guides tell people to copy it.
.env*
!.env.example

# device-bridge trash bin (files moved here instead of deleted) — never ship
_to_delete/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local doc snapshots — live in the folder, not in code history
kula-handoff2.pdf
